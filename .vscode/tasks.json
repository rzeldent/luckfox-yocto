{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build luckfox-image",
            "type": "bitbake",
            "recipes": [
                "luckfox-image"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build core-image-base",
            "type": "bitbake",
            "recipes": [
                "core-image-base"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build core-image-minimal",
            "type": "bitbake",
            "recipes": [
                "core-image-minimal"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Write SD card (bmaptool)",
            "type": "shell",
            "command": "sudo ${workspaceFolder}/flash_sd.sh --machine ${input:machineSdCard} --device ${input:device}",
            "problemMatcher": []
        },
        {
            "label": "Flash SPI NAND (upgrade_tool)",
            "type": "shell",
            "command": "sudo ${workspaceFolder}/flash_spi_nand.sh --machine ${input:machineSpiNand}",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "machineSdCard",
            "type": "pickString",
            "description": "SD card machine to write",
            "options": [
                "luckfox-pico-sd-card",
                "luckfox-pico-plus-sd-card",
                "luckfox-pico-max-sd-card",
                "luckfox-pico-mini-sd-card",
                "luckfox-pico-pi-sd-card"
            ],
            "default": "luckfox-pico-plus-sd-card"
        },
        {
            "id": "machineSpiNand",
            "type": "pickString",
            "description": "SPI NAND machine to flash",
            "options": [
                "luckfox-pico-plus-spi-nand",
                "luckfox-pico-max-spi-nand",
                "luckfox-pico-mini-spi-nand"
            ],
            "default": "luckfox-pico-plus-spi-nand"
        },
        {
            "id": "device",
            "type": "promptString",
            "description": "SD card device (check with 'lsblk' first, e.g. /dev/sdb)",
            "default": "/dev/sdb"
        }
    ]
}
