{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build luckfox-image",
            "type": "bitbake",
            "recipes": [
                "luckfox-image"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build core-image-base",
            "type": "bitbake",
            "recipes": [
                "core-image-base"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Build core-image-minimal",
            "type": "bitbake",
            "recipes": [
                "core-image-minimal"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Write SD card (bmaptool)",
            "type": "shell",
            "command": "sudo ${workspaceFolder}/flash_sd.sh --machine ${input:board} --device ${input:device}",
            "problemMatcher": []
        },
        {
            "label": "Flash SPI NAND (upgrade_tool)",
            "type": "process",
            "command": "sudo",
            "args": [
                "${workspaceFolder}/flash_spi_nand.sh",
                "--machine",
                "${input:board}",
                "--tool-dir",
                "${input:nandToolDir}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "board",
            "type": "pickString",
            "description": "Board machine to write",
            "options": [
                "luckfox-pico",
                "luckfox-pico-plus",
                "luckfox-pico-max",
                "luckfox-pico-mini",
                "luckfox-pico-pi"
            ],
            "default": "luckfox-pico-mini"
        },
        {
            "id": "nandToolDir",
            "type": "promptString",
            "description": "Directory containing upgrade_tool and config.ini (relative to workspace or absolute)",
            "default": "../luckfox-pico/tools/linux/Linux_Upgrade_Tool"
        },
        {
            "id": "device",
            "type": "promptString",
            "description": "SD card device (check with 'lsblk' first, e.g. /dev/sdb)",
            "default": "/dev/sdb"
        }
    ]
}
