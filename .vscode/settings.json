{
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/bitbake/lib",
        "${workspaceFolder}/openembedded-core/meta/lib"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/bitbake/lib",
        "${workspaceFolder}/openembedded-core/meta/lib"
    ],
    "files.associations": {
        "*.conf": "bitbake",
        "*.inc": "bitbake"
    },
    "bitbake.pathToBitbakeFolder": "${workspaceFolder}/bitbake",
    "bitbake.pathToEnvScript": "${workspaceFolder}/openembedded-core/oe-init-build-env",
    "bitbake.sdkImage": "luckfox-image",
    "bitbake.pathToBuildFolder": "${workspaceFolder}/build",
    "bitbake.parseOnSave": false,
    "bitbake.buildConfigurations": [
        {
            "name": "Luckfox Pico (SD card)",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-sd-card",
                "DISTRO": "luckfox-project",
                "BB_ENV_PASSTHROUGH_ADDITIONS": "LUCKFOX_FEATURES",
                "LUCKFOX_FEATURES": "camera npu rga"
            }
        },
        {
            "name": "Luckfox Pico Plus (SD card)",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-plus-sd-card",
                "DISTRO": "luckfox-project",
                "BB_ENV_PASSTHROUGH_ADDITIONS": "LUCKFOX_FEATURES",
                "LUCKFOX_FEATURES": "camera npu rga"
            }
        },
        {
            "name": "Luckfox Pico Plus (SPI NAND)",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-plus-spi-nand",
                "DISTRO": "luckfox-project",
                "BB_ENV_PASSTHROUGH_ADDITIONS": "LUCKFOX_FEATURES",
                "LUCKFOX_FEATURES": "camera npu rga"
            }
        },
        {
            "name": "Luckfox Pico Max (SD card)",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-max-sd-card",
                "DISTRO": "luckfox-project",
                "BB_ENV_PASSTHROUGH_ADDITIONS": "LUCKFOX_FEATURES",
                "LUCKFOX_FEATURES": "camera npu rga"
            }
        },
        {
            "name": "Luckfox Pico Max (SPI NAND)",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-max-spi-nand",
                "DISTRO": "luckfox-project",
                "BB_ENV_PASSTHROUGH_ADDITIONS": "LUCKFOX_FEATURES",
                "LUCKFOX_FEATURES": "camera npu rga"
            }
        },
        {
            "name": "Luckfox Pico Mini (SD card)",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-mini-sd-card",
                "DISTRO": "luckfox-project",
                "BB_ENV_PASSTHROUGH_ADDITIONS": "LUCKFOX_FEATURES",
                "LUCKFOX_FEATURES": "camera npu rga"
            }
        },
        {
            "name": "Luckfox Pico Mini (SPI NAND)",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-mini-spi-nand",
                "DISTRO": "luckfox-project",
                "BB_ENV_PASSTHROUGH_ADDITIONS": "LUCKFOX_FEATURES",
                "LUCKFOX_FEATURES": "camera npu rga"
            }
        },
        {
            "name": "Luckfox Pico Pi (SD card)",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-pi-sd-card",
                "DISTRO": "luckfox-project",
                "BB_ENV_PASSTHROUGH_ADDITIONS": "LUCKFOX_FEATURES",
                "LUCKFOX_FEATURES": "camera npu rga"
            }
        }
    ],
    
    "bitbake.disableConfigModification": true,
    "bitbake.disableDevtoolDebugBuild": true,

    "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "./build/tmp/**": true
    }
}
