{
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/bitbake/lib",
        "${workspaceFolder}/openembedded-core/meta/lib"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/bitbake/lib",
        "${workspaceFolder}/openembedded-core/meta/lib"
    ],
    "files.associations": {
        "*.conf": "bitbake",
        "*.inc": "bitbake"
    },
    "bitbake.pathToBitbakeFolder": "${workspaceFolder}/bitbake",
    "bitbake.pathToEnvScript": "${workspaceFolder}/openembedded-core/oe-init-build-env",
    "bitbake.sdkImage": "core-image-base",
    "bitbake.pathToBuildFolder": "${workspaceFolder}/build",
    "bitbake.parseOnSave": false,
    "bitbake.buildConfigurations": [
        {
            "name": "Luckfox Pico SDCARD",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico",
                "DISTRO": "luckfox",
            }
        },
        {
            "name": "Luckfox Pico SPI NAND",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-spi-nand",
                "DISTRO": "luckfox",
            }
        },
        {
            "name": "Luckfox Pico Plus SDCARD",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-plus",
                "DISTRO": "luckfox",
            }
        },
        {
            "name": "Luckfox Pico Plus SPI NAND",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-plus-spi-nand",
                "DISTRO": "luckfox",
            }
        },
        {
            "name": "Luckfox Pico Max SDCARD",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-max",
                "DISTRO": "luckfox",
            }
        },
        {
            "name": "Luckfox Pico Max SPI NAND",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-max-spi-nand",
                "DISTRO": "luckfox",
            }
        },
        {
            "name": "Luckfox Pico Mini A SDCARD",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-mini-a",
                "DISTRO": "luckfox",
            }
        },
        {
            "name": "Luckfox Pico Mini B SDCARD",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-mini-b",
                "DISTRO": "luckfox",
            }
        },
        {
            "name": "Luckfox Pico Mini B SPI NAND",
            "pathToBuildFolder": "${workspaceFolder}/build",
            "shellEnv": {
                "MACHINE": "luckfox-pico-mini-b-spi-nand",
                "DISTRO": "luckfox",
            }
        }
    ],
    
    "bitbake.disableConfigModification": true,
    "bitbake.disableDevtoolDebugBuild": true
}